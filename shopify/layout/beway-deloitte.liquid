<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'es' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#86bc25">
  <title>{{ page_title | escape }} · BEWAY</title>
  <meta name="description" content="Deloitte en BEWAY: curso propuesto de Auditoría Financiera de ocho horas en dos días, Financial Challenge, miniproyectos y comunidad CLH.">
  <link rel="canonical" href="{{ canonical_url | escape }}">
  <link rel="icon" href="{{ 'bw-deloitte-mark.svg' | asset_url }}" type="image/svg+xml">
  <link rel="preload" href="{{ 'bw-pwc-manrope.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <style>@font-face{font-family:'BEWAY Deloitte DM Sans';font-style:normal;font-weight:100 1000;font-display:swap;src:url({{ 'bw-pwc-dm-sans.woff2' | asset_url }}) format('woff2');}@font-face{font-family:'BEWAY Deloitte Manrope';font-style:normal;font-weight:200 800;font-display:swap;src:url({{ 'bw-pwc-manrope.woff2' | asset_url }}) format('woff2');}</style>
  {{ 'bw-deloitte.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <script src="{{ 'bw-deloitte.js' | asset_url }}" defer></script>
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
